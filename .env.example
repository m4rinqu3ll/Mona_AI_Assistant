APP_ENV=development
LOG_LEVEL=INFO
AUTO_APPROVE_TOOLS=false

# Microsoft Entra ID / Graph (public client using device-code OAuth)
MS_CLIENT_ID=
MS_TENANT_ID=common
MS_SCOPES=User.Read,Mail.ReadWrite,Mail.Send
MS_TOKEN_KEYRING_SERVICE=mona-ai-assistant
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_TIMEOUT_SECONDS=20
GRAPH_MAX_RETRIES=3

# LLM provider: disabled, openai, or deepseek
LLM_PROVIDER=disabled

# DeepSeek (recommended for Mona's first local email-chat test)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=false

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=
OPENAI_REASONING_EFFORT=low
LLM_MAX_TOOL_STEPS=4
